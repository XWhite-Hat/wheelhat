# Copy to .env for a source run. Anything already set in your shell wins over
# this file, and .env is never committed.

# The Twitch application to sign in through. A released build has one baked in;
# a build from source does not, so it asks for one unless this is set.
WHEELHAT_TWITCH_CLIENT_ID=

# Where wheels, tokens and uploaded assets live. Point this at your real
# install to work against your actual wheels:
#   %APPDATA%\WheelHat
# WHEELHAT_DATA_DIR=

# WHEELHAT_HOST=127.0.0.1
# WHEELHAT_PORT=8777
